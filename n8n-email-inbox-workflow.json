    {
      "parameters": {
        "jsCode": "// Extract sender name and subject from email headers\nconst headers = $input.item.json.headers || {};\nconst from = headers.from || '';\nconst subject = headers.subject || '';\n\n// Parse name from \"Name <email@example.com>\" format\nlet fullName = from;\nconst nameMatch = from.match(/^([^<]+)/);\nif (nameMatch) {\n  fullName = nameMatch[1].trim();\n}\n\n// Extract context labels that start with @\nconst labelIds = $input.item.json.labelIds || [];\nconst contextLabels = labelIds\n  .filter(label => label.startsWith('@'))\n  .map(label => `#${label}`)\n  .join(' ');\n\n// Build TODO text\nconst contextTags = contextLabels ? ` ${contextLabels}` : '';\nconst todoText = `- TODO Answer ${fullName}: ${subject} #inbox${contextTags}`;\n\nreturn {\n  json: {\n    template: todoText,\n    originalFrom: from,\n    subject: subject,\n    messageId: $input.item.json.id\n  }\n};"
      },
      "id": "code-answer-format",
      "name": "Code - Format Answer TODO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract subject and context labels\nconst headers = $input.item.json.headers || {};\nconst subject = headers.subject || '';\n\n// Extract context labels that start with @\nconst labelIds = $input.item.json.labelIds || [];\nconst contextLabels = labelIds\n  .filter(label => label.startsWith('@'))\n  .map(label => `#${label}`)\n  .join(' ');\n\n// Build TODO text\nconst contextTags = contextLabels ? ` ${contextLabels}` : '';\nconst todoText = `- TODO ${subject} #inbox${contextTags}`;\n\nreturn {\n  json: {\n    template: todoText,\n    subject: subject,\n    messageId: $input.item.json.id\n  }\n};"
      },
